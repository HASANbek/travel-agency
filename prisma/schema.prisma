generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("agent")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

model City {
  id        Int      @id @default(autoincrement())
  name      String
  nameRu    String?
  nameEn    String?
  country   String   @default("Uzbekistan")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attractions      Attraction[]
  localTransports  LocalTransport[]
  guides           Guide[]
  hotels           Hotel[]
  restaurants      Restaurant[]
  excursions       Excursion[]
  trainDepartures  TrainTicket[]  @relation("TrainFrom")
  trainArrivals    TrainTicket[]  @relation("TrainTo")
  flightDepartures FlightTicket[] @relation("FlightFrom")
  flightArrivals   FlightTicket[] @relation("FlightTo")
  tourCities       TourCity[]

  @@map("cities")
}

model Supplier {
  id             Int      @id @default(autoincrement())
  name           String
  type           String   @default("other")
  contactName    String?
  phone          String?
  email          String?
  contractNumber String?
  paymentTerms   String?
  currency       String   @default("USD")
  bankInfo       String?  @db.Text
  notes          String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  hotels          Hotel[]
  restaurants     Restaurant[]
  localTransports LocalTransport[]
  guides          Guide[]

  @@map("suppliers")
}

model Hotel {
  id            Int      @id @default(autoincrement())
  cityId        Int
  supplierId    Int?
  name          String
  nameRu        String?
  nameEn        String?
  address       String?
  stars         Int      @default(3)
  description   String?  @db.Text
  descriptionRu String?  @db.Text
  descriptionEn String?  @db.Text
  phone         String?
  email         String?
  website       String?
  checkIn       String?
  checkOut      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  city        City            @relation(fields: [cityId], references: [id], onDelete: Cascade)
  supplier    Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  rooms       HotelRoom[]
  rates       HotelRate[]
  tourEntries TourHotelRate[]

  @@index([cityId])
  @@index([supplierId])
  @@map("hotels")
}

model HotelRoom {
  id            Int    @id @default(autoincrement())
  hotelId       Int
  roomType      String
  bedType       String?
  adultCapacity Int    @default(2)
  childCapacity Int    @default(0)

  hotel Hotel       @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  rates HotelRate[]

  @@index([hotelId])
  @@map("hotel_rooms")
}

model HotelRate {
  id                  Int      @id @default(autoincrement())
  hotelId             Int
  roomId              Int
  season              String?
  validFrom           String?
  validTo             String?
  mealPlan            String   @default("BB")
  netUsd              Decimal? @db.Decimal(10, 2)
  netUzs              Decimal? @db.Decimal(14, 2)
  sellUsd             Decimal? @db.Decimal(10, 2)
  sellUzs             Decimal? @db.Decimal(14, 2)
  commissionPercent   Decimal? @db.Decimal(5, 2)
  singleSupplementUsd Decimal? @db.Decimal(10, 2)
  childPriceUsd       Decimal? @db.Decimal(10, 2)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  hotel       Hotel           @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  room        HotelRoom       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  tourEntries TourHotelRate[]

  @@index([hotelId])
  @@index([roomId])
  @@map("hotel_rates")
}

model Restaurant {
  id                Int      @id @default(autoincrement())
  cityId            Int
  supplierId        Int?
  name              String
  nameRu            String?
  nameEn            String?
  address           String?
  cuisine           String?
  capacity          Int?
  mealType          String?
  pricePerPersonUsd Decimal? @db.Decimal(10, 2)
  pricePerPersonUzs Decimal? @db.Decimal(14, 2)
  groupPriceUsd     Decimal? @db.Decimal(10, 2)
  groupPriceUzs     Decimal? @db.Decimal(14, 2)
  phone             String?
  notes             String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  city        City             @relation(fields: [cityId], references: [id], onDelete: Cascade)
  supplier    Supplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  tourEntries TourRestaurant[]

  @@index([cityId])
  @@index([supplierId])
  @@map("restaurants")
}

model Excursion {
  id                Int      @id @default(autoincrement())
  cityId            Int
  name              String
  nameRu            String?
  nameEn            String?
  category          String?
  description       String?  @db.Text
  descriptionRu     String?  @db.Text
  descriptionEn     String?  @db.Text
  durationHours     Decimal? @db.Decimal(5, 2)
  minGroup          Int?
  maxGroup          Int?
  guideRequired     Boolean  @default(false)
  transportRequired Boolean  @default(false)
  netUsd            Decimal? @db.Decimal(10, 2)
  netUzs            Decimal? @db.Decimal(14, 2)
  sellUsd           Decimal? @db.Decimal(10, 2)
  sellUzs           Decimal? @db.Decimal(14, 2)
  season            String?
  notes             String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  city        City            @relation(fields: [cityId], references: [id], onDelete: Cascade)
  tourEntries TourExcursion[]

  @@index([cityId])
  @@map("excursions")
}

model Attraction {
  id             Int      @id @default(autoincrement())
  cityId         Int
  name           String
  nameRu         String?
  nameEn         String?
  description    String?  @db.Text
  descriptionRu  String?  @db.Text
  descriptionEn  String?  @db.Text
  entranceFeeUsd Decimal? @db.Decimal(10, 2)
  entranceFeeUzs Decimal? @db.Decimal(14, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  city        City             @relation(fields: [cityId], references: [id], onDelete: Cascade)
  tourEntries TourAttraction[]

  @@index([cityId])
  @@map("attractions")
}

model LocalTransport {
  id            Int      @id @default(autoincrement())
  cityId        Int
  supplierId    Int?
  type          String   @default("local")
  location      String?
  name          String
  nameRu        String?
  nameEn        String?
  description   String?  @db.Text
  descriptionRu String?  @db.Text
  descriptionEn String?  @db.Text
  phone         String?
  priceUsd    Decimal? @db.Decimal(10, 2)
  priceUzs    Decimal? @db.Decimal(14, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  city        City                 @relation(fields: [cityId], references: [id], onDelete: Cascade)
  supplier    Supplier?            @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  tourEntries TourLocalTransport[]

  @@index([cityId])
  @@index([supplierId])
  @@map("local_transports")
}

model Guide {
  id            Int      @id @default(autoincrement())
  cityId        Int
  supplierId    Int?
  name          String
  description   String?  @db.Text
  descriptionRu String?  @db.Text
  descriptionEn String?  @db.Text
  phone         String?
  priceUsd    Decimal? @db.Decimal(10, 2)
  priceUzs    Decimal? @db.Decimal(14, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  city        City       @relation(fields: [cityId], references: [id], onDelete: Cascade)
  supplier    Supplier?  @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  tourEntries TourGuide[]

  @@index([cityId])
  @@index([supplierId])
  @@map("guides")
}

model TrainTicket {
  id         Int      @id @default(autoincrement())
  fromCityId Int
  toCityId   Int
  trainName  String?
  priceUsd   Decimal? @db.Decimal(10, 2)
  priceUzs   Decimal? @db.Decimal(14, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  fromCity    City              @relation("TrainFrom", fields: [fromCityId], references: [id], onDelete: Cascade)
  toCity      City              @relation("TrainTo", fields: [toCityId], references: [id], onDelete: Cascade)
  tourEntries TourTrainTicket[]

  @@index([fromCityId])
  @@index([toCityId])
  @@map("train_tickets")
}

model FlightTicket {
  id         Int      @id @default(autoincrement())
  fromCityId Int
  toCityId   Int
  airline    String?
  priceUsd   Decimal? @db.Decimal(10, 2)
  priceUzs   Decimal? @db.Decimal(14, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  fromCity    City               @relation("FlightFrom", fields: [fromCityId], references: [id], onDelete: Cascade)
  toCity      City               @relation("FlightTo", fields: [toCityId], references: [id], onDelete: Cascade)
  tourEntries TourFlightTicket[]

  @@index([fromCityId])
  @@index([toCityId])
  @@map("flight_tickets")
}

model Customer {
  id                 Int      @id @default(autoincrement())
  firstName          String
  lastName           String?
  company            String?
  country            String?
  nationality        String?
  language           String?
  email              String?
  phone              String?
  whatsapp           String?
  telegram           String?
  address            String?  @db.Text
  passportNumber     String?
  dateOfBirth        String?
  gender             String?
  customerType       String   @default("individual")
  vipStatus          Boolean  @default(false)
  preferences        String?  @db.Text
  notes              String?  @db.Text
  tags               String?
  source             String?
  responsibleManager String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  inquiries         Inquiry[]
  tours             Tour[]
  quotations        Quotation[]
  bookings          Booking[]
  documents         Document[]
  communicationLogs CommunicationLog[]

  @@index([email])
  @@index([phone])
  @@map("customers")
}

model Inquiry {
  id                   Int      @id @default(autoincrement())
  customerId           Int
  source               String?
  requestDate          String?
  travelStartDate      String?
  travelEndDate        String?
  days                 Int?
  adults               Int      @default(1)
  children             Int      @default(0)
  childrenAges         String?
  countries            String?
  cities               String?
  destinations         String?  @db.Text
  budget               Decimal? @db.Decimal(12, 2)
  currency             String   @default("USD")
  hotelCategory        String?
  roomRequirement      String?
  mealPlan             String?
  transportRequirement String?
  guideRequirement     Boolean  @default(false)
  guideLanguage        String?
  excursionRequirement Boolean  @default(false)
  specialRequests      String?  @db.Text
  notes                String?  @db.Text
  priority             String   @default("medium")
  status               String   @default("new")
  responsibleManager   String?
  nextFollowUpAt       String?
  followUpStep         Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tours    Tour[]

  @@index([customerId])
  @@index([status])
  @@index([nextFollowUpAt])
  @@map("inquiries")
}

model Tour {
  id         Int      @id @default(autoincrement())
  name       String
  notes      String?  @db.Text
  customerId Int?
  inquiryId  Int?
  profitUsd  Decimal  @default(0) @db.Decimal(12, 2)
  profitUzs  Decimal  @default(0) @db.Decimal(16, 2)
  totalUsd   Decimal  @default(0) @db.Decimal(12, 2)
  totalUzs   Decimal  @default(0) @db.Decimal(16, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer        Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  inquiry         Inquiry?             @relation(fields: [inquiryId], references: [id], onDelete: SetNull)
  cities          TourCity[]
  attractions     TourAttraction[]
  localTransports TourLocalTransport[]
  guides          TourGuide[]
  trainTickets    TourTrainTicket[]
  flightTickets   TourFlightTicket[]
  hotelRates      TourHotelRate[]
  restaurants     TourRestaurant[]
  excursions      TourExcursion[]
  quotations      Quotation[]
  bookings        Booking[]

  @@index([customerId])
  @@index([inquiryId])
  @@map("tours")
}

model Quotation {
  id          Int       @id @default(autoincrement())
  tourId      Int
  customerId  Int?
  version     Int       @default(1)
  status      String    @default("draft")
  discountUsd Decimal?  @db.Decimal(12, 2)
  discountUzs Decimal?  @db.Decimal(16, 2)
  taxPercent  Decimal?  @db.Decimal(5, 2)
  validUntil  String?
  terms       String?   @db.Text
  sentAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tour     Tour      @relation(fields: [tourId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  bookings Booking[]

  @@index([tourId])
  @@index([customerId])
  @@index([status])
  @@map("quotations")
}

model Booking {
  id          Int      @id @default(autoincrement())
  quotationId Int?
  tourId      Int
  customerId  Int?
  status      String   @default("confirmed")
  startDate   String?
  totalUsd    Decimal  @default(0) @db.Decimal(12, 2)
  totalUzs    Decimal  @default(0) @db.Decimal(16, 2)
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  quotation Quotation? @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  tour      Tour       @relation(fields: [tourId], references: [id], onDelete: Cascade)
  customer  Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  payments  Payment[]
  vouchers  Voucher[]
  invoices  Invoice[]
  documents Document[]

  @@index([quotationId])
  @@index([tourId])
  @@index([customerId])
  @@index([status])
  @@map("bookings")
}

model Payment {
  id           Int      @id @default(autoincrement())
  bookingId    Int
  type         String   @default("cash")
  amountUsd    Decimal? @db.Decimal(12, 2)
  amountUzs    Decimal? @db.Decimal(16, 2)
  exchangeRate Decimal? @db.Decimal(12, 4)
  paidAt       String?
  reference    String?
  notes        String?  @db.Text
  createdAt    DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("payments")
}

model Voucher {
  id          Int      @id @default(autoincrement())
  bookingId   Int
  serviceType String
  serviceName String?
  day         Int?
  notes       String?  @db.Text
  createdAt   DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("vouchers")
}

model Invoice {
  id            Int      @id @default(autoincrement())
  bookingId     Int
  invoiceNumber String   @unique
  amountUsd     Decimal  @db.Decimal(12, 2)
  amountUzs     Decimal  @db.Decimal(16, 2)
  taxPercent    Decimal? @db.Decimal(5, 2)
  discountUsd   Decimal? @db.Decimal(12, 2)
  discountUzs   Decimal? @db.Decimal(16, 2)
  status        String   @default("unpaid")
  issuedAt      String?
  dueDate       String?
  notes         String?  @db.Text
  createdAt     DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("invoices")
}

model Document {
  id         Int      @id @default(autoincrement())
  customerId Int?
  bookingId  Int?
  fileName   String
  filePath   String
  fileType   String?
  notes      String?
  createdAt  DateTime @default(now())

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  booking  Booking?  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([bookingId])
  @@map("documents")
}

model CommunicationLog {
  id         Int      @id @default(autoincrement())
  customerId Int
  channel    String   @default("other")
  direction  String   @default("outbound")
  message    String   @db.Text
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("communication_logs")
}

model TourTemplate {
  id          Int      @id @default(autoincrement())
  name        String
  description String?  @db.Text
  payload     Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("tour_templates")
}

model Integration {
  id        Int      @id @default(autoincrement())
  channel   String   @unique
  enabled   Boolean  @default(false)
  config    Json
  status    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("integrations")
}

model Expense {
  id          Int      @id @default(autoincrement())
  category    String   @default("other")
  description String
  amountUsd   Decimal? @db.Decimal(12, 2)
  amountUzs   Decimal? @db.Decimal(16, 2)
  date        String
  notes       String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([date])
  @@map("expenses")
}

model TourCity {
  id       Int @id @default(autoincrement())
  tourId   Int
  cityId   Int
  position Int @default(0)

  tour Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)
  city City @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@index([tourId])
  @@index([cityId])
  @@map("tour_cities")
}

model TourAttraction {
  id           Int      @id @default(autoincrement())
  tourId       Int
  attractionId Int
  day          Int      @default(1)
  quantity     Int      @default(1)
  unitPriceUsd Decimal? @db.Decimal(10, 2)
  unitPriceUzs Decimal? @db.Decimal(14, 2)

  tour       Tour       @relation(fields: [tourId], references: [id], onDelete: Cascade)
  attraction Attraction @relation(fields: [attractionId], references: [id], onDelete: Cascade)

  @@index([tourId])
  @@index([attractionId])
  @@map("tour_attractions")
}

model TourLocalTransport {
  id               Int      @id @default(autoincrement())
  tourId           Int
  localTransportId Int
  day              Int      @default(1)
  time             String?
  quantity         Int      @default(1)
  unitPriceUsd     Decimal? @db.Decimal(10, 2)
  unitPriceUzs     Decimal? @db.Decimal(14, 2)

  tour           Tour           @relation(fields: [tourId], references: [id], onDelete: Cascade)
  localTransport LocalTransport @relation(fields: [localTransportId], references: [id], onDelete: Cascade)

  @@index([tourId])
  @@index([localTransportId])
  @@map("tour_local_transports")
}

model TourGuide {
  id           Int      @id @default(autoincrement())
  tourId       Int
  guideId      Int
  day          Int      @default(1)
  quantity     Int      @default(1)
  unitPriceUsd Decimal? @db.Decimal(10, 2)
  unitPriceUzs Decimal? @db.Decimal(14, 2)

  tour  Tour  @relation(fields: [tourId], references: [id], onDelete: Cascade)
  guide Guide @relation(fields: [guideId], references: [id], onDelete: Cascade)

  @@index([tourId])
  @@index([guideId])
  @@map("tour_guides")
}

model TourTrainTicket {
  id            Int      @id @default(autoincrement())
  tourId        Int
  trainTicketId Int
  day           Int      @default(1)
  quantity      Int      @default(1)
  unitPriceUsd  Decimal? @db.Decimal(10, 2)
  unitPriceUzs  Decimal? @db.Decimal(14, 2)

  tour        Tour        @relation(fields: [tourId], references: [id], onDelete: Cascade)
  trainTicket TrainTicket @relation(fields: [trainTicketId], references: [id], onDelete: Cascade)

  @@index([tourId])
  @@index([trainTicketId])
  @@map("tour_train_tickets")
}

model TourFlightTicket {
  id             Int      @id @default(autoincrement())
  tourId         Int
  flightTicketId Int
  day            Int      @default(1)
  quantity       Int      @default(1)
  unitPriceUsd   Decimal? @db.Decimal(10, 2)
  unitPriceUzs   Decimal? @db.Decimal(14, 2)

  tour         Tour         @relation(fields: [tourId], references: [id], onDelete: Cascade)
  flightTicket FlightTicket @relation(fields: [flightTicketId], references: [id], onDelete: Cascade)

  @@index([tourId])
  @@index([flightTicketId])
  @@map("tour_flight_tickets")
}

model TourHotelRate {
  id           Int      @id @default(autoincrement())
  tourId       Int
  hotelId      Int
  hotelRateId  Int
  day          Int      @default(1)
  nights       Int      @default(1)
  quantity     Int      @default(1)
  unitPriceUsd Decimal? @db.Decimal(10, 2)
  unitPriceUzs Decimal? @db.Decimal(14, 2)

  tour  Tour      @relation(fields: [tourId], references: [id], onDelete: Cascade)
  hotel Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  rate  HotelRate @relation(fields: [hotelRateId], references: [id], onDelete: Cascade)

  @@index([tourId])
  @@index([hotelId])
  @@index([hotelRateId])
  @@map("tour_hotel_rates")
}

model TourRestaurant {
  id           Int      @id @default(autoincrement())
  tourId       Int
  restaurantId Int
  day          Int      @default(1)
  quantity     Int      @default(1)
  unitPriceUsd Decimal? @db.Decimal(10, 2)
  unitPriceUzs Decimal? @db.Decimal(14, 2)

  tour       Tour       @relation(fields: [tourId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([tourId])
  @@index([restaurantId])
  @@map("tour_restaurants")
}

model TourExcursion {
  id          Int      @id @default(autoincrement())
  tourId      Int
  excursionId Int
  day         Int      @default(1)
  quantity    Int      @default(1)
  unitPriceUsd Decimal? @db.Decimal(10, 2)
  unitPriceUzs Decimal? @db.Decimal(14, 2)

  tour      Tour      @relation(fields: [tourId], references: [id], onDelete: Cascade)
  excursion Excursion @relation(fields: [excursionId], references: [id], onDelete: Cascade)

  @@index([tourId])
  @@index([excursionId])
  @@map("tour_excursions")
}
